-- =====================================================================================
-- CHURCH MANAGEMENT SYSTEM SCHEMA
-- This file defines the PostgreSQL database schema for the entire Church platform.
-- =====================================================================================

CREATE EXTENSION IF NOT EXISTS "pgcrypto";

-- =====================================================================================
-- 1. CORE MEMBERSHIP & AUTHENTICATION
-- =====================================================================================

-- Stores all registered users of the system (students/parishioners).
CREATE TABLE members (
    member_id VARCHAR(30) PRIMARY KEY NOT NULL,  -- Unique alphanumeric ID for the member
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    gender VARCHAR(10),
    email VARCHAR(100) UNIQUE,
    phone VARCHAR(20),
    year_of_study VARCHAR(20),
    course VARCHAR(100),
    password VARCHAR NOT NULL,                   -- Hashed password
    join_date DATE DEFAULT CURRENT_DATE
);

-- Handles temporary one-time passwords for password recovery.
CREATE TABLE password_resets (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid() UNIQUE,
    member_id VARCHAR(30) REFERENCES members(member_id) ON DELETE CASCADE,
    email VARCHAR(100),
    otp TEXT NOT NULL,                           -- Encrypted or plain OTP code
    otp_expires TIMESTAMP NOT NULL,              -- Expiration timestamp for the OTP
    temp_password TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT NOW()
);
-- Defines administrative and functional roles (e.g., 'Admin', 'Choir_Leader').
CREATE TABLE refresh_tokens (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    member_id VARCHAR(30) REFERENCES members(member_id) ON DELETE CASCADE,
    token TEXT NOT NULL,
    expires_at TIMESTAMP NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    revoked BOOLEAN DEFAULT FALSE
);
CREATE TABLE roles (
    role_id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    role_name VARCHAR(50) NOT NULL
);

-- Many-to-Many mapping of members to roles.
CREATE TABLE member_roles (
    member_id VARCHAR(30) REFERENCES members(member_id),
    role_id uuid REFERENCES roles(role_id),
    PRIMARY KEY(member_id, role_id)
);

-- =====================================================================================
-- 2. EVENTS & CONTRIBUTIONS
-- =====================================================================================

-- General church events or parish gatherings.
CREATE TABLE events (
    event_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    event_name VARCHAR(100) NOT NULL,
    event_date DATE NOT NULL,
    location VARCHAR(100),
    description TEXT
);

-- Tracks financial or material contributions by members, linked to specific events.
CREATE TABLE contributions (
    contribution_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    member_id VARCHAR(30) REFERENCES members(member_id) ON DELETE CASCADE,
    event_id UUID REFERENCES events(event_id) ON DELETE SET NULL,
    amount DECIMAL(10, 2) NOT NULL,
    contribution_type VARCHAR(50),               -- e.g., 'Tithe', 'Thanksgiving', 'Project'
    contribution_date DATE DEFAULT CURRENT_DATE
);

-- =====================================================================================
-- 3. SUB-GROUPS / JUMUIYAS (Small Christian Communities)
-- =====================================================================================
-- Note: 'sub_groups' acts as the central hub for all Jumuiya-related functionality.
-- It contains both generic subgroup fields and Jumuiya-specific content.

CREATE TABLE sub_groups (
    group_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    slug VARCHAR(100) UNIQUE,                    -- URL-friendly slug (e.g., 'st-anthony') used heavily by frontend APIs
    name VARCHAR(200) NOT NULL,                  -- Short display name
    full_name VARCHAR(200),                      -- Formal name (e.g., 'St. Anthony of Padua')
    description TEXT,                            -- Catchphrase or motto
    about TEXT,                                  -- Rich-text history and background
    color VARCHAR(30),                           -- Hex code theme color for the UI
    saint_image VARCHAR(500),                    -- URL/Path to the patron saint's image
    history_pdf VARCHAR(500),                    -- URL/Path to history documentation
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

-- Tracks attendance counts per subgroup for global events.
CREATE TABLE event_subgroup_attendance (
    event_id UUID REFERENCES events(event_id) ON DELETE CASCADE,
    group_id UUID REFERENCES sub_groups(group_id) ON DELETE CASCADE,
    attendance_count INT NOT NULL CHECK (attendance_count >= 0),
    PRIMARY KEY (event_id, group_id)
);

-- =====================================================================================
-- 4. UTILITIES & GLOBAL FEATURES
-- =====================================================================================

-- System-wide notifications sent to members.
CREATE TABLE notifications (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    title VARCHAR(100),
    message VARCHAR(255),
    is_read BOOLEAN DEFAULT FALSE,
    posted_by UUID REFERENCES users(id),         -- Note: 'users' table is not defined in this file, might need checking
    posted_at TIMESTAMP DEFAULT NOW(),
    posted_to VARCHAR(100) NOT NULL,             -- Target audience (e.g., 'All', 'Choir')
    member_id VARCHAR(30) REFERENCES members(member_id), -- Target specific member
    status VARCHAR(100) DEFAULT 'normal' CHECK (status IN ('normal', 'urgent', 'info'))
);

-- Tracks generic file uploads across the system (Cloudinary or local paths).
CREATE TABLE IF NOT EXISTS uploads (
    id SERIAL PRIMARY KEY,
    public_id TEXT UNIQUE NOT NULL,              -- Cloudinary public_id or unique hash
    url TEXT NOT NULL,
    format TEXT,
    resource_type TEXT,                          -- 'image', 'video', 'pdf'
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================================================
-- 5. JUMUIYA EXTENSION TABLES (Linked to sub_groups(slug))
-- =====================================================================================

-- Regular meeting schedules for each Jumuiya.
CREATE TABLE IF NOT EXISTS jumuiya_meeting_schedule (
    id              SERIAL        PRIMARY KEY,
    jumuiya_id      VARCHAR(100)  NOT NULL REFERENCES sub_groups(slug) ON DELETE CASCADE,
    day             VARCHAR(50),
    time            VARCHAR(100),
    venue           VARCHAR(200),
    UNIQUE (jumuiya_id)                          -- Ensures one schedule entry per Jumuiya
);

-- Tracks the active service period/year for current officials.
CREATE TABLE IF NOT EXISTS jumuiya_term_of_office (
    id              SERIAL        PRIMARY KEY,
    jumuiya_id      VARCHAR(100)  NOT NULL REFERENCES sub_groups(slug) ON DELETE CASCADE,
    start_year      VARCHAR(10)   NOT NULL,
    end_year        VARCHAR(10)   NOT NULL,
    UNIQUE (jumuiya_id)
);

-- Archival record of previous Jumuiya leaders.
CREATE TABLE IF NOT EXISTS jumuiya_former_officials (
    id              SERIAL        PRIMARY KEY,
    jumuiya_id      VARCHAR(100)  NOT NULL REFERENCES sub_groups(slug) ON DELETE CASCADE,
    name            VARCHAR(200)  NOT NULL,
    position        VARCHAR(100),
    photo           VARCHAR(500),
    years_served    VARCHAR(50)
);

-- Official membership registry specific to a Jumuiya.
CREATE TABLE IF NOT EXISTS jumuiya_members (
    id              SERIAL        PRIMARY KEY,
    jumuiya_id      VARCHAR(100)  NOT NULL,      -- Note: Consider adding REFERENCES sub_groups(slug) here later
    name            VARCHAR(200)  NOT NULL,
    year            VARCHAR(20),
    phone           VARCHAR(50),
    email           VARCHAR(200),
    is_registered   BOOLEAN       DEFAULT FALSE, -- True if they are fully registered with the parish/chaplaincy
    joined_at       TIMESTAMP     DEFAULT NOW()
);

-- Retreats, fundraisers, or internal events specific to one Jumuiya.
CREATE TABLE IF NOT EXISTS jumuiya_activities (
    id              SERIAL        PRIMARY KEY,
    jumuiya_id      VARCHAR(100)  NOT NULL,
    title           VARCHAR(200)  NOT NULL,
    description     TEXT,
    activity_date   DATE,
    time            VARCHAR(100),
    location        VARCHAR(200),
    type            VARCHAR(50),                 -- e.g., 'meeting', 'retreat', 'charity'
    created_at      TIMESTAMP     DEFAULT NOW()
);

-- Photo albums for Jumuiya events.
CREATE TABLE IF NOT EXISTS jumuiya_gallery_albums (
    id              SERIAL        PRIMARY KEY,
    jumuiya_id      VARCHAR(100)  NOT NULL,
    cover_url       VARCHAR(500),
    caption         VARCHAR(300),
    created_at      TIMESTAMP     DEFAULT NOW()
);

-- Individual photos inside a specific Jumuiya gallery album.
CREATE TABLE IF NOT EXISTS jumuiya_gallery_images (
    id              SERIAL        PRIMARY KEY,
    album_id        INTEGER       NOT NULL REFERENCES jumuiya_gallery_albums(id) ON DELETE CASCADE,
    url             VARCHAR(500)  NOT NULL,
    caption         VARCHAR(300),
    sort_order      INTEGER       DEFAULT 0      -- For custom sorting on the frontend
);

-- Jumuiya-specific announcements and alerts shown on their dashboard.
CREATE TABLE IF NOT EXISTS jumuiya_notifications (
    id              SERIAL        PRIMARY KEY,
    jumuiya_id      VARCHAR(100)  NOT NULL,
    title           VARCHAR(300)  NOT NULL,
    message         TEXT          NOT NULL,
    type            VARCHAR(20)   NOT NULL DEFAULT 'info'
                    CHECK (type IN ('info', 'warning', 'success', 'urgent')),
    posted_by       VARCHAR(100),
    posted_at       TIMESTAMP     DEFAULT NOW()
);

-- External links to the Jumuiya's Facebook, WhatsApp group, Instagram, etc.
CREATE TABLE IF NOT EXISTS jumuiya_social_media (
    id              SERIAL        PRIMARY KEY,
    jumuiya_id      VARCHAR(100)  NOT NULL,
    platform        VARCHAR(100)  NOT NULL,
    url             VARCHAR(500)  NOT NULL
);

-- Merchandise order tracking for Jumuiya-branded t-shirts.
CREATE TABLE IF NOT EXISTS jumuiya_tshirt_orders (
    id              SERIAL        PRIMARY KEY,
    jumuiya_id      VARCHAR(100)  NOT NULL,
    holder_name     VARCHAR(200)  NOT NULL,      -- Person who the shirt is for
    payer_name      VARCHAR(200),                -- Person who paid (if different)
    phone           VARCHAR(50),
    size            VARCHAR(5)    NOT NULL DEFAULT 'M'
                    CHECK (size IN ('XS', 'S', 'M', 'L', 'XL', 'XXL')),
    quantity        INTEGER       NOT NULL DEFAULT 1,
    submitted_at    TIMESTAMP     DEFAULT NOW()
);