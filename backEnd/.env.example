# ============================================================================
# CSA Kirinyaga backend — environment template
# ----------------------------------------------------------------------------
# Copy this file to `backEnd/.env` and fill in real values:
#
#     cd backEnd
#     cp .env.example .env
#
# NEVER commit `backEnd/.env`. It is git-ignored on purpose.
# In production, set these in the Render dashboard (or via the blueprint in
# backEnd/render.yaml) instead of shipping a file.
#
# Values below are safe placeholders only.
# ============================================================================

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
# development | production. In production the JWT secrets below are mandatory.
NODE_ENV=development

# Local API listener. Render injects PORT automatically; leave blank locally
# to use the default 3001.
PORT=3001
HOST=0.0.0.0

# Comma-separated list of allowed browser origins (no trailing slash).
# Include every deployed frontend plus local dev when needed.
# Example:
# CORS_ORIGIN=http://localhost:5173,https://your-site.vercel.app,https://your-attendance-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Canonical public site origin used in links/redirects (no trailing slash).
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# PostgreSQL (Aiven in production)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=csa_db

# Hosted Postgres requires TLS. Set both to true for Aiven/Render.
DB_SSL=false
DB_SSL_ALLOW_SELF_SIGNED=false

# Optional connection string used by a few standalone scripts (e.g.
# src/scripts/deleteTestMembers.js). The API itself uses the DB_* values.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ----------------------------------------------------------------------------
# Auth / JWT
# ----------------------------------------------------------------------------
# Production REQUIRES JWT_ACCESS_SECRET and JWT_REFRESH_SECRET, and they must
# be DIFFERENT. The server refuses to boot otherwise (src/utils/jwtConfig.js).
# Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-different-from-access

# Development-only fallback used when the two secrets above are unset.
# Do not set this in production.
JWT_SECRET=change-me-dev-fallback

# Legacy token secret kept for backwards compatibility. Optional.
# ACCESS_TOKEN_SECRET=change-me-legacy-secret

# ----------------------------------------------------------------------------
# AI — Groq (daily questions, weekly challenge, assistant chat)
# ----------------------------------------------------------------------------
GROQ_API_KEY=gsk_replace-me

# ----------------------------------------------------------------------------
# Cloudinary (image/video uploads)
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# ----------------------------------------------------------------------------
# M-Pesa — Safaricom Daraja (STK push / payments)
# Leave blank to disable payment features locally.
# ----------------------------------------------------------------------------
CONSUMER_KEY=replace-me
CONSUMER_SECRET=replace-me
SHORTCODE=174379
PASSKEY=replace-me

# Must be publicly reachable over HTTPS for callbacks to arrive.
CALLBACK_URL=https://your-api.example.com/api/v1/stkPush/callback

# sandbox | production. Defaults to sandbox when unset.
MPESA_ENV=sandbox
# Optional override for the Daraja base URL (e.g. a proxy).
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# ----------------------------------------------------------------------------
# Email — Resend HTTPS API
# Render blocks outbound SMTP, so Resend is the supported production path.
# Email is skipped while RESEND_API_KEY / RESEND_FROM are unset.
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_replace-me
RESEND_FROM="CSA Kirinyaga <no-reply@your-domain.example>"
RESEND_REPLY_TO=reply@your-domain.example

# Legacy SMTP credentials. Kept for reference only; SMTP cannot be used on
# Render. Optional.
# MAIL_USER=
# MAIL_PASSWORD=

# ----------------------------------------------------------------------------
# SMS — Africa's Talking (optional)
# ----------------------------------------------------------------------------
# AT_API_KEY=
# AT_USERNAME=sandbox
# AT_SENDER_ID=

# ----------------------------------------------------------------------------
# Cloudflare Turnstile (optional captcha)
# ----------------------------------------------------------------------------
# When TURNSTILE_SECRET_KEY is empty, captcha verification is skipped entirely.
# Create the widget under the CSA Cloudflare account, then pair this secret
# with VITE_TURNSTILE_SITEKEY in the frontend.
# TURNSTILE_SECRET_KEY=
# Set to true to allow requests through when Cloudflare is unreachable.
# TURNSTILE_FAIL_OPEN=false

# ----------------------------------------------------------------------------
# Misc / optional
# ----------------------------------------------------------------------------
# Choir-song parsing / OCR helpers.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_VISION_API_KEY=

# Enables POST /api/v1/setup/admin to create the first admin. Use briefly in
# development only, then remove.
# SETUP_ADMIN_ENABLED=false

# How often the role-sync worker runs. Defaults to 10 minutes.
# ROLE_SYNC_INTERVAL_MS=600000

# Reserved for caching/rate limiting. Currently not wired up.
# REDIS_URL=redis://localhost:6379

# Legacy MongoDB Atlas connection. No active code path reads it; leave unset
# unless you are reviving the old mongoose models.
# MONGODB_URI=
